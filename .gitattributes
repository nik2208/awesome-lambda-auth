# Default: let git normalise text in the repo, check out native on the host.
* text=auto

# Anything executed inside a Linux container must keep LF, or the shebang
# breaks with "bad interpreter: No such file or directory".
*.sh text eol=lf
Makefile text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.go text eol=lf
